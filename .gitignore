../*

# we do not need to lock these, just have the latest everything
.python-version
uv.lock

# Python virtual environment
.venv/

# NEW Splat Things
asm/*
undefined_syms_auto.txt
undefined_funcs_auto.txt
kirby.ld
assets/boot.bin

**/**/*.bin
build/*
tools/GeoFromBin*
tools/level_settings/convert
tools/img_getprop
tools/rgb2c
tools/armips_bin/*
assets/*.bin
assets/**/*.png
assets/tools/__pycache__/*
tools/splat_ext/__pycache__/*
f3dex2/F3DEX2_2.04H/*
*.z64
textures/*
bin/*
.assets-local.txt
tools/mipspro*/
tools/gfxdis.f3dex2
tools/gfxdis_f3dex2
tools/n64graphics
tools/iplfontutil
tools/n64crc
tools/patch_libultra_math
tools/extract_assets
*.o
epic.*
__pycache__/*
tools/scut/__pycache__/*
tools/temp_tools/__pycache__/*
tools/asm-processor/__pycache__/*
asm-differ/__pycache__/*
.vscode/*
ctx.c
*.m2c
# Use these for scratch work
*.x
strings/*
# asm-differ and objdiff .o file diffs
expected/*

# Python bytecode, anywhere. The entries above are path-specific and miss
# any new tools directory (tools/decomp/ was untracked because of this).
**/__pycache__/
*.pyc

# decomp-permuter working directories (scratch output, not source)
tools/decomp/perm/

# libultraship writes a runtime log here; it churns on every run of the port.
logs/

# libultraship writes its runtime config here on every run of the port.
kirby64.cfg

# Agents sweep source variants in temp copies named with a leading dot, beside
# the real file -- GNU make's wildcard never matches those, so a concurrent
# build cannot pick them up. They are scratch, never deliverables.
src/**/.*.c
cand.json
*.ab_tmp.c
kirby64.eep
port/o2r/*.o2r

# Lane progress notes: written by background agents every few closures so a
# lane that dies still delivers what it had. Working notes, not deliverables.
scratchpad/

# mk.sh stores a sha1 beside each object so a source restored with an older
# mtime still forces a rebuild. Build metadata, not source.
*.srchash

# decomp-permuter is a third-party clone, not our source. SESSION_SETUP.sh fetches it.
tools/decomp/decomp-permuter/

# m2c is a third-party clone, not our source. SESSION_SETUP.sh fetches it.
tools/decomp/m2c/

# The PC port lives in JR3DFUL/HALBERD. (This used to say kirby64_port; that
# repository is retired -- following the stale name cost a round trip.)
# These paths are still present and buildable in this checkout so the port can
# be developed against a byte-exact tree, but they are tracked in HALBERD, not
# here. Sync them across before relying on either copy.
Makefile.pc
tools/pc/
src/pc/
port/
docs/PC_PORT_*.md
kirby64.cfg.json
halberd.cfg.json
logs/

# asm-processor scratch files. One got committed and carried an absolute
# build path into the repository.
.jbx_tmp_*
*.asmproc.d
