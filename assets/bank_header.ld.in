#define START_GEO(bank, index) \
    . = ALIGN(16);\
    bank_##bank##_index_##index##_geo_start = .;

#define END_GEO(bank, index) \
    bank_##bank##_index_##index##_geo_end = ALIGN(., 16);

#define START_MISC(bank, index) \
    bank_##bank##_index_##index##_misc_start = .;

#define END_MISC(bank, index) \
    bank_##bank##_index_##index##_misc_end = .; \
    _bank_##bank##_misc_size += (bank_##bank##_index_##index##_misc_end - bank_##bank##_index_##index##_misc_start);

#define START_IMG(bank, index) \
    bank_##bank##_index_##index##_image_start = .;

#define END_IMG(bank, index) \
    bank_##bank##_index_##index##_image_end = .; \
    _bank_##bank##_image_size += (bank_##bank##_index_##index##_image_end - bank_##bank##_index_##index##_image_start);

#define START_ANIM(bank, index) \
    bank_##bank##_index_##index##_anim_start = .;

#define END_ANIM(bank, index) \
    bank_##bank##_index_##index##_anim_end = .; \
    _bank_##bank##_anim_size += (bank_##bank##_index_##index##_anim_end - bank_##bank##_index_##index##_anim_start);

#define GEO_INIT(bank) \
    . = ALIGN(., 16);\

#define IMAGE_INIT(bank) \
    _bank_##bank##_image_size = 0;\
    bank_##bank##_index_1_image_start = .;

#define ANIM_INIT(bank) \
    . = ALIGN(., 16);\
    _bank_##bank##_anim_size = 0;\
    bank_##bank##_index_1_anim_start = .;

#define MISC_INIT(bank) \
    . = ALIGN(., 16);\
    _bank_##bank##_misc_size = 0;\
    bank_##bank##_index_1_misc_start = .;

/* custom types */

#define GEO(bank, index, filename) \
    START_GEO(bank, index) \
    filename(.data*);\
    END_GEO(bank, index)

#define IMAGE(bank, index, filename) \
    START_IMG(bank, index) \
    filename(.data*);\
    END_IMG(bank, index)

#define ANIM(bank, index, filename) \
    START_ANIM(bank, index) \
    filename(.data*);\
    END_ANIM(bank, index)

#define MISC(bank, index, filename) \
    START_MISC(bank, index) \
    filename(.data*);\
    END_MISC(bank, index)

#define FILLER(filetype, bank) \
    BYTE(0x39);\
    BYTE(0x39);\
    BYTE(0x39);\
    BYTE(0x0A);\
    . = ALIGN(16);
